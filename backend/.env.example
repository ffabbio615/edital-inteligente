# Aplicação
NODE_ENV=development
PORT=3001
API_PREFIX=/api

# Banco de dados (opcional nesta etapa; o servidor inicia sem estas variáveis)
# Opção 1: string de conexão completa (tem prioridade sobre as variáveis individuais).
# Exemplo de formato: postgresql://usuario:senha@host:5432/banco
DATABASE_URL=

# Opção 2: variáveis individuais (usadas apenas se DATABASE_URL estiver vazia).
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
# Use true para conexões que exigem SSL (como o Supabase).
DB_SSL=false

# Chave do endpoint de integração com o n8n (header x-integration-key).
# OBRIGATÓRIA em produção; mínimo de 32 caracteres. Sem ela, o endpoint nega tudo.
# Gere uma chave aleatória (PowerShell):
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
N8N_INTEGRATION_SECRET=

# Reservadas para etapas futuras (ainda não utilizadas)
N8N_WEBHOOK_URL=
GEMINI_API_KEY=
GEMINI_MODEL=
